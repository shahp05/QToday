# Copy this to .env and fill in your values
DATABASE_URL=postgresql://user:password@localhost:5432/qtoday
SECRET_KEY=change-me

# Used by llm/factory.py — required for every LLM call (QA generation,
# subject/topic validation, quiz/challenge scoring). Which model handles
# each purpose is configurable in the app_settings table (llm_model_map),
# not hardcoded.
OPENAI_API_KEY=

# Email (SMTP) — used for signup verification codes
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@yourdomain.com
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
